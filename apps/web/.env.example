# Example environment for apps/web. Copy to .env.local if you need to change anything.
# There are no secrets in this app: it is a front-end-only prototype and all demo data
# lives in the browser.

# Path the site is served under. Leave empty for local development (http://localhost:3000/).
# The GitHub Pages workflow sets it automatically (e.g. /Quire); `npm run build:pages` uses /Quire.
NEXT_PUBLIC_BASE_PATH=
