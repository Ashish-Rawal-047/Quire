# Copy to services/api/.env — all values below are for LOCAL DEVELOPMENT ONLY.

QUIRE_ENV=development

# Postgres (docker compose maps it to host port 5433)
QUIRE_DATABASE_URL=postgresql+asyncpg://quire:quire_dev_password@localhost:5433/quire

# S3-compatible object storage (SeaweedFS locally). Holds ciphertext only.
QUIRE_S3_ENDPOINT=http://localhost:9000
QUIRE_S3_ACCESS_KEY=quire
QUIRE_S3_SECRET_KEY=quire_dev_password
QUIRE_S3_BUCKET=quire-documents
QUIRE_S3_REGION=ap-south-1

# Email (Mailpit catches everything; inbox at http://localhost:8025)
QUIRE_SMTP_HOST=localhost
QUIRE_SMTP_PORT=1025
QUIRE_MAIL_FROM=Quire <no-reply@quire.local>

# Master key that wraps per-document encryption keys (base64, 32 bytes).
# Generate your own: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Production: replace with a cloud KMS key — never a value in an env file.
QUIRE_MASTER_KEY=

# Epoch keys (they wrap per-document keys). Keep this folder OUT of every backup: deleted documents
# stay unreadable in database backups only because these keys are destroyed on schedule.
QUIRE_KEYSTORE_DIR=var/keystore
QUIRE_KEY_EPOCH_HOURS=6
# Per-document scratch folders (unused in Phase 1; Phase 2 conversion needs a RAM-backed mount).
QUIRE_WORKSPACE_DIR=var/workspaces
QUIRE_MAX_UPLOAD_BYTES=52428800
# Retention sweep interval in seconds (purges documents, destroys epoch keys). 0 disables it.
QUIRE_RETENTION_SWEEP_SECONDS=60

# Malware scanning (ClamAV) is not built yet; documents are marked "not scanned" — never "clean".
QUIRE_CLAMAV_ENABLED=false
QUIRE_CLAMAV_HOST=localhost
QUIRE_CLAMAV_PORT=3310

# Payments. "mock" runs with no keys and is labelled TEST everywhere. "razorpay" uses Razorpay TEST-mode keys.
QUIRE_PAYMENT_PROVIDER=mock
QUIRE_RAZORPAY_KEY_ID=
QUIRE_RAZORPAY_KEY_SECRET=
QUIRE_RAZORPAY_WEBHOOK_SECRET=

# Origin of the web app. Every non-GET request must carry exactly this Origin header.
QUIRE_WEB_ORIGIN=http://localhost:3000

# Sessions: HttpOnly, Secure, SameSite=Lax cookies (browsers accept Secure on http://localhost).
QUIRE_COOKIE_SECURE=true
QUIRE_SESSION_IDLE_DAYS=7
QUIRE_SESSION_ABSOLUTE_DAYS=30

# Peers whose X-Forwarded-For is trusted, as a JSON list. Keep EMPTY unless a reverse proxy in
# front of the API overwrites that header; then list only that proxy (e.g. ["10.0.0.5"]).
QUIRE_TRUSTED_PROXIES=[]

# smtp (Mailpit locally) or memory (tests only).
QUIRE_MAIL_BACKEND=smtp
